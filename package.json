{
  "name": "papermorning",
  "version": "1.0.0",
  "description": "PaperMorning self-hosted backend (NestJS + PostgreSQL + TypeORM)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r dotenv/config src/main.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "PM_TEST_SKIP_DB=1 jest --selectProjects unit",
    "migration:run": "typeorm migration:run -d dist/service/persistence/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/service/persistence/data-source.js",
    "migration:show": "typeorm migration:show -d dist/service/persistence/data-source.js",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/service/persistence/data-source.ts",
    "cli": "node dist/bootstrap/cli.js"
  },
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "fast-xml-parser": "^5.12.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.8",
    "typescript-eslint": "^8.73.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
