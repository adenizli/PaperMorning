# Copy to .env and replace every placeholder. Never commit .env.

NODE_ENV=development
PORT=3000

# --- PostgreSQL (docker-compose.yml reads POSTGRES_*; the app reads DATABASE_URL) ---
POSTGRES_USER=papermorning
POSTGRES_PASSWORD=change-me
POSTGRES_DB=papermorning
POSTGRES_PORT=5432
DATABASE_URL=postgres://papermorning:change-me@localhost:5432/papermorning
DATABASE_SSL=false
DATABASE_LOGGING=false
