# Copy to .env and replace every placeholder. Never commit .env.

NODE_ENV=development
PORT=3000

# --- PostgreSQL (docker-compose.yml reads POSTGRES_*; the app reads DATABASE_URL) ---
POSTGRES_USER=papermorning
POSTGRES_PASSWORD=change-me
POSTGRES_DB=papermorning
POSTGRES_PORT=5432
DATABASE_URL=postgres://papermorning:change-me@localhost:5432/papermorning
DATABASE_SSL=false
DATABASE_LOGGING=false

# --- Claude API (optional at startup; without a key, LLM steps fail visibly and are never faked) ---
ANTHROPIC_API_KEY=
# Fixed task -> model routing. Opus is refused unless LLM_OPUS_ENABLED=true.
LLM_MODEL_SCREENING=claude-haiku-5-5
LLM_MODEL_ANALYSIS=claude-sonnet-5-5
LLM_MODEL_WRITING=claude-sonnet-5-5
LLM_MODEL_OUTLOOK=claude-sonnet-5-5
LLM_OPUS_ENABLED=false
# Hard daily spend cap (USD, UTC day), checked before every call against a worst-case estimate.
LLM_DAILY_BUDGET_USD=5
LLM_TIMEOUT_MS=180000
# Optional price overrides/extra models: {"model-id":{"inputPerMTokUsd":2,"outputPerMTokUsd":10}}
LLM_PRICING_JSON=

# --- Research discovery (OpenAlex + arXiv) ---
# Optional contact address for OpenAlex's polite pool.
OPENALEX_MAILTO=
RESEARCH_LOOKBACK_DAYS=7
RESEARCH_DISCOVERY_LIMIT_PER_SOURCE=25
RESEARCH_MAX_CANDIDATES_PER_TOPIC=5
RESEARCH_HAIKU_SCREENING=true
RESEARCH_MAX_HAIKU_SCREENINGS_PER_RUN=20
RESEARCH_SOURCE_TIMEOUT_MS=20000
RESEARCH_LEASE_SECONDS=600
