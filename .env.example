# Copy to .env and replace every placeholder. Never commit .env.

NODE_ENV=development
PORT=3000

# --- PostgreSQL (docker-compose.yml reads POSTGRES_*; the app reads DATABASE_URL) ---
POSTGRES_USER=papermorning
POSTGRES_PASSWORD=change-me
POSTGRES_DB=papermorning
POSTGRES_PORT=5432
DATABASE_URL=postgres://papermorning:change-me@localhost:5432/papermorning
DATABASE_SSL=false
DATABASE_LOGGING=false

# --- Claude API (optional at startup; without a key, LLM steps fail visibly and are never faked) ---
ANTHROPIC_API_KEY=
# Fixed task -> model routing. Opus is refused unless LLM_OPUS_ENABLED=true.
LLM_MODEL_SCREENING=claude-haiku-5-5
LLM_MODEL_ANALYSIS=claude-sonnet-5-5
LLM_MODEL_WRITING=claude-sonnet-5-5
LLM_MODEL_OUTLOOK=claude-sonnet-5-5
LLM_OPUS_ENABLED=false
# Hard daily spend cap (USD, UTC day), checked before every call against a worst-case estimate.
LLM_DAILY_BUDGET_USD=5
LLM_TIMEOUT_MS=180000
# Optional price overrides/extra models: {"model-id":{"inputPerMTokUsd":2,"outputPerMTokUsd":10}}
LLM_PRICING_JSON=

# --- Research discovery (OpenAlex + arXiv) ---
# Optional contact address for OpenAlex's polite pool.
OPENALEX_MAILTO=
RESEARCH_LOOKBACK_DAYS=7
RESEARCH_DISCOVERY_LIMIT_PER_SOURCE=25
RESEARCH_MAX_CANDIDATES_PER_TOPIC=5
RESEARCH_HAIKU_SCREENING=true
RESEARCH_MAX_HAIKU_SCREENINGS_PER_RUN=20
RESEARCH_SOURCE_TIMEOUT_MS=20000
RESEARCH_LEASE_SECONDS=600

# --- Authentication (3-hour non-refreshable access token) ---
# Required, at least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_NAME=pm_session
# Keep true in production (HTTPS). Set false only for plain-HTTP local development.
AUTH_COOKIE_SECURE=true
# Extra browser origins allowed to call the API (comma separated, never "*"). Same-origin needs none.
CORS_ORIGINS=
# Operator safeguards (no admin UI): close signups and/or cap accounts (0 = unlimited).
REGISTRATION_ENABLED=true
MAX_USERS=0
AUTH_RATE_LIMIT_PER_MINUTE=10
# true when running behind a reverse proxy (correct client IPs for rate limiting).
TRUST_PROXY=false

# --- Publication and delivery ---
# Externally reachable URL of the web client used in emails (optional). A LAN-only address will not
# work for readers away from home; the PDF is always attached regardless.
PUBLIC_BASE_URL=
PUBLICATION_MAX_ARTICLES=6
PUBLICATION_MAX_ATTEMPTS=5
PUBLICATION_RETRY_BACKOFF_MINUTES=10
PUBLICATION_LEASE_SECONDS=900
# Raw PDF limit; base64 MIME encoding adds about one third on the wire.
MAIL_MAX_ATTACHMENT_BYTES=10485760
MAIL_MAX_ATTEMPTS=3

# --- PDF rendering (Playwright/Chromium) and private storage ---
# Private, persistent directory for issue PDFs (<DATA_DIR>/private). Never web-served. Back it up with the DB.
DATA_DIR=./data
PDF_TIMEOUT_MS=60000
PDF_MAX_CONCURRENCY=1
# Keep true on a normal host. docker-compose.yml sets false: Chromium's sandbox cannot start inside an
# unprivileged container (verified); there the non-root container is the isolation boundary.
PDF_CHROMIUM_SANDBOX=true
PDF_MAX_SNAPSHOT_BYTES=2097152
# Optional explicit Chromium binary; default is the browser installed by `npx playwright install chromium`.
PDF_CHROMIUM_EXECUTABLE=

# --- SMTP (self-hosted operator's own provider). Leave SMTP_HOST empty to disable sending:
# the app still prepares issues and PDFs; deliveries then show DISABLED, never SENT. ---
SMTP_HOST=
# starttls (587, upgrade required) | tls (465, implicit TLS) | none (plaintext, development only)
SMTP_SECURE=starttls
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PaperMorning <papermorning@example.org>
SMTP_REPLY_TO=
MAIL_ENABLED=true
# Development only (e.g. a local sink with a self-signed certificate). Rejected when NODE_ENV=production.
SMTP_ALLOW_INSECURE=false
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=60000

# --- Daily scheduler (one server process only; CLI processes never run it) ---
SCHEDULER_ENABLED=true
# Reader-local time at which automatic preparation starts (delivery is fixed at 08:00 local).
SCHEDULER_PREPARE_LOCAL_TIME=06:00
# A late-but-READY issue is still emailed until 08:00 + this many minutes; after that, no email and no
# further automatic (paid) preparation for that day. Operators can still run `publication:prepare`.
SCHEDULER_LATE_WINDOW_MINUTES=120
